@using AirlinesReservationSystem.Helper;
@{
    string _active = "";
    string _controller = ViewContext.RouteData.Values["controller"].ToString();
    string _action = ViewContext.RouteData.Values["action"].ToString();
    string currentAction = ViewContext.RouteData.Values["controller"].ToString() + "/" + ViewContext.RouteData.Values["action"].ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link rel="Shortcut Icon" href="~/Asset/img/a1.png" type="img/x-icon" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://getbootstrap.com/docs/5.2/assets/css/docs.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/js/vendor/jquery-1.11.2.min.js"></script>
    <title>@ViewBag.Title - Bán vé máy bay</title>

    <style>
        #SettingBar > .card.active {
            background-color: lightgray;
        }

        #SettingBar > .card:hover {
            background-color: lightgray;
            transform: scale(0.9);
            transition: all linear 0.5s;
        }
    </style>

</head>
<body class="container-fluid">
    <div class="container-fluid" style=" margin-top: 10px; z-index: 100">
        <nav class="navbar navbar-expand-md">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">
                    <img src="~/Asset/logo.png" style="object-fit: fill; mix-blend-mode: multiply;" width="80" height="40" alt="Logo">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarData" aria-controls="navbarData" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarData">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0" style="margin-right:20px">
                        @{
                            var roles = Session["role"].ToString();
                            if (roles == null)
                            {

                            }
                            else if (Session["Role"].ToString() == "Admin")
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="dropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @roles : @HttpContext.Current.Session["NameEmployee"].ToString()
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                        <li class="@{_active = _controller == "Employee" ? "active" : ""; @_active}">
                                            <a class="dropdown-item" title="Nhân viên" href="@Url.Action("Index", "Employee")">Nhân viên</a>
                                        </li>
                                        <li class="@{_active = _controller == "Plane" ? "active" : ""; @_active}">
                                            <a class="dropdown-item" title="Máy bay" href="@Url.Action("Index", "Plane")">Máy bay</a>
                                        </li>
                                        <li class="@{_active = _controller == "Airport" ? "active" : ""; @_active}">
                                            <a class="dropdown-item" title="Địa điểm" href="@Url.Action("Index","Airport")">Địa điểm</a>
                                        </li>
                                        <li class="@{_active = _controller == "ChartFlight" ? "active" : ""; @_active}">
                                            <a class="dropdown-item" title="Thống kê" href="@Url.Action("Index","ChartFlight")">Thống kê</a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("Logout","Default")">Đăng xuất</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="dropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @roles : @HttpContext.Current.Session["NameEmployee"].ToString()
                                    </a>
                                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                        <li class="@{_active = _controller == "ChartFlight" ? "active" : ""; @_active}">
                                            <a class="dropdown-item" title="Thống kê" href="@Url.Action("Index","ChartFlight")">Thống kê</a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("Logout","Default")">Đăng xuất</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </div>
    <div class="container-fluid overflow-auto" style=" margin-top:10px ;  ">
        <div id="SettingBar" class="row justify-content-md-around align-items-md-center gy-1" style="">
            @{ var activeClass = _controller == "Users" ? "active" : ""; }
            <div class="col-md-2  card shadow @activeClass" style="">
                <div class="card-body">
                    <h6 class="card-title">Khách hàng <i class="fa fa-address-book"></i> </h6>
                    <p class="card-link"> @if (activeClass == "")
                    {<a href=@Url.Action("Index","Users")>Chuyển sang..</a>}
                    else
                    { <p class="h6" style="color:mediumblue;text-shadow:0px 0px 2px black">@activeClass</p>} </p>
                </div>
            </div>
            @{ var activeClass2 = _controller == "FlightSchedules" ? "active" : ""; }
            <div class="col-md-2 card shadow @activeClass2" style="">
                <div class="card-body">
                    <h6 class="card-title">Chuyến bay <i class="fa fa-calendar-check-o"></i> </h6>
                    <p class="card-link"> @if (activeClass2 == "")
                    {<a href=@Url.Action("Index","FlightSchedules")>Chuyển sang..</a>}
                    else
                    { <p class="h6" style="color:mediumblue;text-shadow:0px 0px 2px black">@activeClass2</p>} </p>
                </div>
            </div>
            @{ var activeClass3 = _controller == "TicketManagers" ? "active" : ""; }
            <div class="col-md-2 card shadow @activeClass3" style="">
                <div class="card-body">
                    <h6 class="card-title">Vé bay <i class="fa fa-ticket"></i> </h6>
                    <p class="card-link"> @if (activeClass3 == "")
                    {<a href=@Url.Action("Index","TicketManagers")>Chuyển sang..</a>}
                    else
                    { <p class="h6" style="color:mediumblue;text-shadow:0px 0px 2px black">@activeClass3</p>} </p>
                </div>
            </div>
            @{ var activeClass4 = _controller == "Payments" ? "active" : ""; }
            <div class="col-md-2 card shadow @activeClass4" style="">
                <div class="card-body">
                    <h6 class="card-title">Thanh toán <i class="fa fa-credit-card"></i> </h6>
                    <p class="card-link"> @if (activeClass4 == "")
                    {<a href=@Url.Action("Index","Payments")>Chuyển sang..</a>}
                    else
                    { <p class="h6" style="color:mediumblue;text-shadow:0px 0px 2px black">@activeClass4</p>} </p>
                </div>
            </div>
            @{ var activeClass5 = _controller == "Baggage" ? "active" : ""; }
            <div class="col-md-2 card shadow @activeClass5" style="">
                <div class="card-body">
                    <h6 class="card-title">Hành lí <i class="fa fa-suitcase"></i> </h6>
                    <p class="card-link"> @if (activeClass5 == "")
                    {<a href=@Url.Action("Index","Baggage")>Chuyển sang..</a>}
                    else
                    { <p class="h6" style="color:mediumblue;text-shadow:0px 0px 2px black">@activeClass5</p>} </p>
                </div>
            </div>
        </div>
    </div>
    <hr />
            @Html.Raw(AlertHelper.showAlert())
    <div style="margin-top:20px;padding : 10px ;background-color: lavender">

        @RenderBody()
    </div>

    <div class="body-content">
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @RenderSection("scripts", required: false)

</body>

</html>
