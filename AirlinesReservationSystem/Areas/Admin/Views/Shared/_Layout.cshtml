@using AirlinesReservationSystem.Helper;
@{
    string _active = "";
    string _controller = ViewContext.RouteData.Values["controller"].ToString();
    string _action = ViewContext.RouteData.Values["action"].ToString();
    string currentAction = ViewContext.RouteData.Values["controller"].ToString() + "/" + ViewContext.RouteData.Values["action"].ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="Shortcut Icon" href="~/Asset/img/a1.png" type="img/x-icon" />

    <link rel="stylesheet" href="~/Content/css/bootstrap.min.css">

    <link rel="stylesheet" href="~/Content/Site.css">
    <script src="~/Scripts/js/vendor/modernizr-2.8.3-respond-1.4.2.min.js"></script>
    <script src="~/Scripts/js/vendor/jquery-1.11.2.min.js"></script>
    <script src="~/Scripts/js/vendor/bootstrap.min.js"></script>
    <script src="~/Scripts/js/plugins.js"></script>
    <script src="~/Scripts/js/main.js"></script>
    <script src="~/Scripts/custom.js"></script>
    <title>@ViewBag.Title - Bán vé máy bay</title>

    <style>
        .nav-item {
            text-align: left;
            overflow: hidden;
            white-space: nowrap;
            /*text-overflow: ellipsis;*/
        }

        .navbar-nav .nav-item:hover {
            background-color: lightgray !important;
            Màu nền khi hover
        }

        Định nghĩa màu chữ mặc định
        .navbar-nav .nav-link {
            color: white;
            Màu chữ mặc định
        }

        Định nghĩa màu chữ khi hover
        .navbar-nav .nav-item:hover .nav-link {
            color: black !important;
            Màu chữ khi hover
        }

        Thêm hiệu ứng đổ bóng khi hover
        .navbar-nav .nav-item {
            transition: box-shadow 0.3s ease;
            Thêm hiệu ứng chuyển tiếp
        }

        .navbar-nav .nav-item:hover {
            box-shadow: 6px 8px 10px rgba(0, 0, 0, 0.5);
            Đổ bóng khi hover
        }
    </style>

</head>
<body class="container-fluid">
    <div class="container-fluid" style="width: 100%; background-color: rgb(0 0 0 / 53%); z-index: 100; height:auto">
        <nav class="navbar navbar-expand-lg navbar-dark ">
            <div class="container-fluid">
                <div class="navbar-header">
                    <a class="navbar-brand " href="#">
                        <img src="~/Asset/logo.png" style="width:80px ; height:40px;margin-top:5px" alt="logo" />
                    </a>
                    <button type="button" style="background-color:white;margin-top:15px;" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#myNavbar">
                        <span style="background-color:gray" class="icon-bar"></span>
                        <span style="background-color:gray" class="icon-bar"></span>
                        <span style="background-color:gray" class="icon-bar"></span>
                    </button>
                </div>
                <br />
                <div class="collapse navbar-collapse" id="myNavbar">
                    @{
                        var roles = Session["Role"];
                        if (roles == null)
                        {
                            <div style="margin-left:0%" class="collapse navbar-collapse" id="navbarNavDropdown">
                                <ul class="navbar-nav mx-auto">
                                    <li class="nav-item mr-3 ">
                                        <a class="nav-link" href="@Url.Action("Logout","Default")">Đăng xuất</a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else if (Session["Role"].ToString() == "Admin")
                        {

                            <ul class="nav navbar-nav m-sm-auto m-lg-0 ">
                                <li class="nav-item  @{_active = _controller == "Users" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Người dùng" href="@Url.Action("Index", "Users")">Người dùng</a>
                                </li>
                                <li class="nav-item  @{_active = _controller == "FlightSchedules" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Chuyến bay" href="@Url.Action("Index", "FlightSchedules")">Chuyến bay</a>
                                </li>

                                <li class="nav-item  @{_active = _controller == "TicketManagers" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Vé" href="@Url.Action("Index", "TicketManagers")">Vé</a>
                                </li>
                                <li class="nav-item  @{_active = _controller == "Payments" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Thanh Toán" href="@Url.Action("Index", "Payments")">Thanh Toán</a>
                                </li>
                                <li class="nav-item  @{_active = _controller == "Baggage" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Hành lý" href="@Url.Action("Index", "Baggage")">Hành lý</a>
                                </li>

                                <!-- Dropdown Menu -->
                                <li>
                                    <a class="nav-link dropdown-toggle" href="#" id="dropdownMenuLink" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        Chức Năng <span class="caret"></span>
                                    </a>
                                    <ul class="dropdown-menu" style="">
                                        <li class="nav-item  @{_active = _controller == "Employee" ? "active" : ""; @_active}">
                                            <a class="nav-link" title="Nhân viên" href="@Url.Action("Index", "Employee")">Nhân viên</a>
                                        </li>
                                        <li class="nav-item   @{_active = _controller == "Plane" ? "active" : ""; @_active}">
                                            <a class="nav-link" title="Máy bay" href="@Url.Action("Index", "Plane")">Máy bay</a>
                                        </li>
                                        <li class="nav-item   @{_active = _controller == "Airport" ? "active" : ""; @_active}">
                                            <a class="nav-link" title="Địa điểm" href="@Url.Action("Index","Airport")">Địa điểm</a>
                                        </li>
                                        <li class="nav-item  @{_active = _controller == "ChartFlight" ? "active" : ""; @_active}">
                                            <a class="nav-link" title="Thống kê" href="@Url.Action("Index","ChartFlight")">Thống kê</a>
                                        </li>
                                        <li class="nav-item  ">
                                            <a class="nav-link" href="@Url.Action("Logout","Default")">Đăng xuất</a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>

                        }
                        else
                        {

                            <ul class="nav navbar-nav pull-right">
                                <li class="nav-item  @{_active = _controller == "Users" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Người dùng" href="@Url.Action("Index","Users")">Người dùng</a>
                                </li>
                                <li class="nav-item  @{_active = _controller == "FlightSchedules" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Chuyến bay" href="@Url.Action("Index","FlightSchedules")">Chuyến bay</a>
                                </li>

                                <li class="nav-item  @{_active = _controller == "TicketManagers" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Vé" href="@Url.Action("Index","TicketManagers")">Vé</a>
                                </li>
                                <li class="nav-item  @{_active = _controller == "Payments" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Thanh Toán" href="@Url.Action("Index","Payments")">Thanh Toán</a>
                                </li>
                                <li class="nav-item  @{_active = _controller == "Baggage" ? "active" : ""; @_active}">
                                    <a class="nav-link" title="Hành lý" href="@Url.Action("Index","Baggage")">Hành lý</a>
                                </li>
                                <li class="nav-item ">
                                    <a class="nav-link" href="@Url.Action("Logout","Default")">Đăng xuất</a>
                                </li>
                            </ul>

                        }

                    }
                </div>
            </div>

        </nav>
    </div>


    <div style="margin-top:20px">
        @Html.Raw(AlertHelper.showAlert())

        @RenderBody()
    </div>

    <div class="body-content">
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - My ASP.NET Application</p>
        </footer>
    </div>

    @RenderSection("scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
